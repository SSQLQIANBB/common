{
  "name": "@sycsq/common",
  "version": "0.0.4",
  "description": "一个基于 Vite 构建的 TypeScript 工具库，提供 HTTP 请求封装和常用工具函数，支持完整的类型声明",
  "keywords": [
    "typescript",
    "utils",
    "http",
    "axios",
    "vite",
    "types",
    "javascript",
    "node",
    "browser"
  ],
  "author": {
    "name": "sycsq",
    "email": "mufengxidalao@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SSQLQIANBB/common.git"
  },
  "bugs": {
    "url": "https://github.com/SSQLQIANBB/common/issues"
  },
  "homepage": "https://github.com/SSQLQIANBB/common/blob/main/README.md",
  "private": false,
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./http": {
      "types": "./types/http/index.d.ts",
      "import": "./lib/http.js",
      "require": "./lib/http.cjs"
    },
    "./http/Axios": {
      "types": "./types/http/Axios.d.ts",
      "import": "./lib/http/Axios.js",
      "require": "./lib/http/Axios.cjs"
    },
    "./http/axiosCancel": {
      "types": "./types/http/axiosCancel.d.ts",
      "import": "./lib/http/axiosCancel.js",
      "require": "./lib/http/axiosCancel.cjs"
    },
    "./http/axiosTransform": {
      "types": "./types/http/axiosTransform.d.ts",
      "import": "./lib/http/axiosTransform.js",
      "require": "./lib/http/axiosTransform.cjs"
    },
    "./http/helper": {
      "types": "./types/http/helper.d.ts",
      "import": "./lib/http/helper.js",
      "require": "./lib/http/helper.cjs"
    },
    "./http/types": {
      "types": "./types/http/types.d.ts",
      "import": "./lib/http/types.js",
      "require": "./lib/http/types.cjs"
    },
    "./utils": {
      "types": "./types/utils/index.d.ts",
      "import": "./lib/utils.js",
      "require": "./lib/utils.cjs"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "lib",
    "types",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc && vite build",
    "build:types": "tsc --emitDeclarationOnly",
    "prepublishOnly": "npm run build",
    "version:patch": "node scripts/version.js patch",
    "version:minor": "node scripts/version.js minor",
    "version:major": "node scripts/version.js major",
    "publish:patch": "npm run version:patch && npm publish",
    "publish:minor": "npm run version:minor && npm publish",
    "publish:major": "npm run version:major && npm publish",
    "example:install": "pnpm install --filter personal-utils-example",
    "example:dev": "pnpm dev --filter personal-utils-example",
    "example:build": "pnpm build --filter personal-utils-example",
    "example:preview": "pnpm preview --filter personal-utils-example",
    "example:setup": "pnpm install && pnpm build && pnpm example:dev"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "vite": "^7.0.6",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "axios": "^1.11.0"
  },
  "peerDependenciesMeta": {}
}
